{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "description": [
        "Vite+ selects these bundled versions. Update direct pins to match Vite+ toolchain upgrades, never independently."
      ],
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "vite",
        "rolldown",
        "tsdown",
        "vitest",
        "@vitest/**",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt"
      ],
      "enabled": false
    },
    {
      "description": ["Update Vite+ and its Vite alias and overrides together."],
      "matchManagers": ["bun"],
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "Vite+ toolchain",
      "groupSlug": "vite-plus-toolchain"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/^(7\\.0\\.)/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
