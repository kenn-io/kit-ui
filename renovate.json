{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "description": [
        "Vite+ selects these bundled versions. Update direct pins to match Vite+ toolchain upgrades, never independently."
      ],
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "vite",
        "rolldown",
        "tsdown",
        "vitest",
        "@vitest/**",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt"
      ],
      "enabled": false
    },
    {
      "description": ["Update Vite+ and its Vite alias and overrides together."],
      "matchManagers": ["bun"],
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "Vite+ toolchain",
      "groupSlug": "vite-plus-toolchain"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/^(7\\.0\\.)/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": [
        "kenn-io releases open right away: no release-age wait and no weekly window."
      ],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies",
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    }
  ]
}
